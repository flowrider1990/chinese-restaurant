# Copy to .env and fill in. Never commit .env.

# Local dev: a libSQL file. Turso: libsql://<db-name>-<org>.turso.io
DATABASE_URL=file:./data/local.db
# Only needed for Turso (leave empty for a local file DB)
DATABASE_AUTH_TOKEN=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public base URL used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail (reservations). Without RESEND_API_KEY, mails are only written to the server log.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=reservierung@example.com
EMAIL_FROM_NAME=Xiao Chu

# Protects GET /api/reservations/cleanup (daily job). Long random string.
CRON_SECRET=replace-with-a-long-random-string

# Stripe (vouchers). Test keys only (sk_test_...); live keys are refused.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --print-secret` (dev) or the Stripe dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Vercel Blob (CMS images). Set automatically on Vercel by the connected Blob store.
# Locally, images stay in media/ unless MEDIA_ON_BLOB=1 is also set (that writes into the store).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
# MEDIA_ON_BLOB=1

# Shared demo only (build time, Vercel Production): keep the site out of search engines.
# SITE_NOINDEX=1
